# Configuração dos serviços do ak820ctl (~/.config/ak820ctl/ak820.env).
# Depois de editar:  systemctl --user restart ak820-hyperhdr.service

# Por onde falar com o teclado: auto (cabo se a chave estiver em USB, senão dongle), wired ou dongle
AK820_VIA=auto

# HyperHDR (o servidor JSON precisa estar ligado no HyperHDR).
# 127.0.0.1 se ele roda neste PC; senão, o IP da máquina dele (ex.: o add-on do Home Assistant).
AK820_HYPERHDR_HOST=127.0.0.1
AK820_HYPERHDR_PORT=19444

# Pelo dongle: segundos mínimos entre trocas de cor (poupa a memória do teclado)
AK820_MIN_GAP=2

# Watchdog do dongle (ak820-watchdog.service), em segundos. Depois de uma tecla, se o dongle ficar
# em silêncio, reinicia a cada AK820_WD_SILENCE durante AK820_WD_FAST_WINDOW; depois o intervalo
# dobra de AK820_WD_BACKOFF_START até AK820_WD_BACKOFF_MAX; desiste após AK820_WD_GIVE_UP.
# Depois de editar:  systemctl --user restart ak820-watchdog.service
AK820_WD_SILENCE=30
AK820_WD_FAST_WINDOW=900
AK820_WD_BACKOFF_START=60
AK820_WD_BACKOFF_MAX=1800
AK820_WD_GIVE_UP=7200
